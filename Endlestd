		end)
	end
end)

-- ==========================================
-- INITIALIZATION & AUTOPLAY CHECK
-- ==========================================
task.spawn(function()
	task.wait(1.5)
	-- Eksekusi awal 2x speed jika tombol default-nya ON
	if autoSpeedEnabled then
		setSpeed(2)
	end
	local isAutoPlay, configToLoad = getAutoPlayState()
	if isAutoPlay and configToLoad then
		autoPlayEnabled = true
		InputFileName.Text = configToLoad
		BtnAutoPlayToggle.Text = "Auto Play On Rejoin: ON"
		BtnAutoPlayToggle.BackgroundColor3 = Color3.fromRGB(0, 170, 90)
		logConsole("AutoPlay Aktif. Memuat " .. configToLoad .. "...")
		if loadMacroFromFile(configToLoad) then
			task.wait(1)
			startPlayback()
		end
	end
end)
