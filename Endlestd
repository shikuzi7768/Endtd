-- Fallback Safe File System
local function safeWriteFile(name, content)
	if writefile then pcall(writefile, name, content) end
end

local function safeReadFile(name)
	if readfile and isfile and isfile(name) then
		local s, res = pcall(readfile, name)
		if s then return res end
	end
	return nil
end

local function setGameSpeedTo2X()
	if not MacroData.AutoSpeedEnabled then return end
	if SpeedEvent then
		pcall(function()
			SpeedEvent:FireServer(2)
		end)
	end
end

-- Storage Logic
local function saveAllDataToFile()
	local serializableActions = {}
	for _, act in ipairs(recordedActions) do
		local actCopy = {
			time = act.time,
			type = act.type,
			towerName = act.towerName
		}
		if act.pos then actCopy.pos = {X = act.pos.X, Y = act.pos.Y, Z = act.pos.Z} end
		if act.args then
			actCopy.args = {}
			for i, v in ipairs(act.args) do
				if typeof(v) == "Vector3" then
					actCopy.args[i] = {Type = "Vector3", X = v.X, Y = v.Y, Z = v.Z}
				else
					actCopy.args[i] = v
				end
			end
		end
		table.insert(serializableActions, actCopy)
	end

	MacroData.Slots[MacroData.SelectedSlot] = serializableActions

	local success, json = pcall(function() return HttpService:JSONEncode(MacroData) end)
	if success then
		safeWriteFile(SAVE_FILE_NAME, json)
	end
end

local function loadAllDataFromFile()
	local json = safeReadFile(SAVE_FILE_NAME)
	if not json then return false end

	local success, result = pcall(function() return HttpService:JSONDecode(json) end)
	if success and result and result.Slots then
		MacroData = result
		if MacroData.AutoSpeedEnabled == nil then MacroData.AutoSpeedEnabled = true end
		return true
	end
	return false
end

local function loadSlotToRuntime(slotNumber)
	recordedActions = {}
	local targetActions = MacroData.Slots[slotNumber] or {}

	for _, act in ipairs(targetActions) do
		local actCopy = {
			time = act.time,
			type = act.type,
			towerName = act.towerName
		}
		if act.pos then actCopy.pos = Vector3.new(act.pos.X, act.pos.Y, act.pos.Z) end
		if act.args then
			actCopy.args = {}
			for i, v in ipairs(act.args) do
				if typeof(v) == "table" and v.Type == "Vector3" then
					actCopy.args[i] = Vector3.new(v.X, v.Y, v.Z)
				else
					actCopy.args[i] = v
				end
			end
		end
		table.insert(recordedActions, actCopy)
	end
end

-- Spatial Helper
local function getTowerNearPosition(targetPos)
	if not targetPos then return nil end
	local closestTower = nil
	local shortestDistance = 5

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and (obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) then
			local part = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
			if part then
				local dist = (part.Position - targetPos).Magnitude
				if dist < shortestDistance then
					shortestDistance = dist
					closestTower = obj
				end
			end
		end
	end
	return closestTower
end

local function getTowerPosition(towerInstance)
	if typeof(towerInstance) == "Instance" then
		local part = towerInstance.PrimaryPart or towerInstance:FindFirstChild("HumanoidRootPart") or towerInstance:FindFirstChildWhichIsA("BasePart")
		if part then return part.Position end
	end
	return nil
end

