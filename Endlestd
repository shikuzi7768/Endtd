-- ==========================================
-- SAVE & LOAD SYSTEM
-- ==========================================

local function serializeData(data)
	local serialized = {}
	for _, entry in ipairs(data) do
		local copy = {
			Type = entry.Type,
			Time = entry.Time,
			TurretIndex = entry.TurretIndex,
			TowerId = entry.TowerId,
			TurretName = entry.TurretName
		}
		if entry.Position then
			copy.Position = {X = entry.Position.X, Y = entry.Position.Y, Z = entry.Position.Z}
		end
		table.insert(serialized, copy)
	end
	return serialized
end

local function deserializeData(data)
	local deserialized = {}
	for _, entry in ipairs(data) do
		local copy = {
			Type = entry.Type,
			Time = entry.Time,
			TurretIndex = entry.TurretIndex,
			TowerId = entry.TowerId,
			TurretName = entry.TurretName
		}
		if entry.Position then
			copy.Position = Vector3.new(entry.Position.X, entry.Position.Y, entry.Position.Z)
		end
		table.insert(deserialized, copy)
	end
	return deserialized
end

local function saveMacroToFile(fileName)
	if #macroData == 0 then
		logConsole("Error: Tidak ada data makro!")
		return
	end
	if not writefile then
		logConsole("Error: Executor tidak support writefile!")
		return
	end

	local filePath = FOLDER_NAME .. "/" .. fileName .. ".json"
	local formattedData = serializeData(macroData)
	local jsonString = HttpService:JSONEncode(formattedData)
	writefile(filePath, jsonString)
	logConsole("Tersimpan: " .. fileName .. ".json")
end

local function loadMacroFromFile(fileName)
	if not readfile or not isfile then
		logConsole("Error: Executor tidak support readfile!")
		return false
	end

	local filePath = FOLDER_NAME .. "/" .. fileName .. ".json"
	if not isfile(filePath) then
		logConsole("File " .. fileName .. " tidak ditemukan!")
		return false
	end

	local jsonString = readfile(filePath)
	local rawData = HttpService:JSONDecode(jsonString)
	macroData = deserializeData(rawData)
	logConsole("Loaded: " .. fileName .. " (" .. #macroData .. " aksi)")
	return true
end

local function setAutoPlayState(state, configName)
	if not writefile then return end
	local autoPlayData = {
		Enabled = state,
		ConfigName = configName or "Makro1"
	}
	writefile(FOLDER_NAME .. "/AutoPlaySettings.json", HttpService:JSONEncode(autoPlayData))
end

local function getAutoPlayState()
	if not isfile or not readfile then return false, nil end
	local path = FOLDER_NAME .. "/AutoPlaySettings.json"
	if isfile(path) then
		local data = HttpService:JSONDecode(readfile(path))
		return data.Enabled, data.ConfigName
	end
	return false, nil
end

-- FITUR BARU: Fungsi Konversi Data Makro ke Teks Lua Kode & Copy
local function copyMacroDataToClipboard()
	if #macroData == 0 then
		logConsole("Error: Tidak ada data untuk di-copy!")
		return
	end

	local luaTableString = "local MACRO_DATA = {\n"
	for _, entry in ipairs(macroData) do
		if entry.Type == "Place" then
			local posStr = string.format("Vector3.new(%.2f, %.2f, %.2f)", entry.Position.X, entry.Position.Y, entry.Position.Z)
			luaTableString = luaTableString .. string.format('\t{ Type = "Place", Time = %.2f, TowerId = "%s", Position = %s, TurretIndex = %d },\n', entry.Time, tostring(entry.TowerId), posStr, entry.TurretIndex)
		elseif entry.Type == "Upgrade" then
			luaTableString = luaTableString .. string.format('\t{ Type = "Upgrade", Time = %.2f, TurretIndex = %d },\n', entry.Time, entry.TurretIndex)
		end
	end
	luaTableString = luaTableString .. "}"

	local setclipboardFunc = setclipboard or toclipboard or set_clipboard
	if setclipboardFunc then
		setclipboardFunc(luaTableString)
		logConsole("✅ Data Makro Berhasil Di-copy ke Clipboard!")
	else
		logConsole("Error: Executor tidak mendukung setclipboard!")
	end
end

-- ==========================================
-- PLAYBACK ENGINE
-- ==========================================
local function getGameSpeed()
	return autoSpeedEnabled and 2 or 1
end

local function startPlayback()
	if isRecording or isPlaying then return end
	if #macroData == 0 then
		logConsole("Error: Data Makro Kosong!")
		return
	end

	isPlaying = true
	spawnedTurretsPlayback = {}
	if autoSpeedEnabled then
		setSpeed(2)
	end
	BtnPlay.Text = "Playing..."
	BtnPlay.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
	logConsole("Playback Started...")

	local turretConnection
	local placedFolder = workspace:FindFirstChild("PlacedTurrets") or workspace:WaitForChild("PlacedTurrets", 5)
	if placedFolder then
		turretConnection = placedFolder.ChildAdded:Connect(function(child)
			if isPlaying then
				table.insert(spawnedTurretsPlayback, child)
			end
		end)
	end

	task.spawn(function()
		local playStartTime = os.clock()

		for index, action in ipairs(macroData) do
			if not isPlaying then break end

			local targetTime = action.Time
			while (os.clock() - playStartTime) * getGameSpeed() < targetTime do
				task.wait()
			end

			if action.Type == "Place" and PlaceEvent then
				PlaceEvent:FireServer(action.TowerId, action.Position)
				logConsole(string.format("[%d/%d] Place #%d", index, #macroData, action.TurretIndex))
			elseif action.Type == "Upgrade" and ActionEvent then
				local targetTurret = spawnedTurretsPlayback[action.TurretIndex]
				if targetTurret and targetTurret:IsDescendantOf(workspace) then
					if ActionEvent:IsA("RemoteFunction") then
						ActionEvent:InvokeServer("Upgrade", targetTurret)
					else
						ActionEvent:FireServer("Upgrade", targetTurret)
					end
					logConsole(string.format("[%d/%d] Upgrade: %s", index, #macroData, targetTurret.Name))
				else
					logConsole(string.format("[%d/%d] Tower #%d Hilang!", index, #macroData, action.TurretIndex))
				end
			end
		end

		if turretConnection then turretConnection:Disconnect() end
		isPlaying = false
		BtnPlay.Text = "Play"
		BtnPlay.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
		logConsole("Playback Selesai!")
	end)
end

