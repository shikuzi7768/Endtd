-- Safe File Operations (Tidak akan membuat script crash/gantung jika executor tidak support)
local function safeWriteFile(name, content)
	pcall(function()
		if writefile then
			writefile(name, content)
		end
	end)
end

local function safeReadFile(name)
	local result = nil
	pcall(function()
		if readfile and isfile and isfile(name) then
			result = readfile(name)
		end
	end)
	return result
end

-- Storage Logic Safe
local function saveAllDataToFile()
	pcall(function()
		local serializableActions = {}
		for _, act in ipairs(recordedActions) do
			local actCopy = {
				time = act.time,
				type = act.type,
				towerName = act.towerName
			}
			if act.pos then actCopy.pos = {X = act.pos.X, Y = act.pos.Y, Z = act.pos.Z} end
			if act.args then
				actCopy.args = {}
				for i, v in ipairs(act.args) do
					if typeof(v) == "Vector3" then
						actCopy.args[i] = {Type = "Vector3", X = v.X, Y = v.Y, Z = v.Z}
					else
						actCopy.args[i] = v
					end
				end
			end
			table.insert(serializableActions, actCopy)
		end

		MacroData.Slots[MacroData.SelectedSlot] = serializableActions
		local json = HttpService:JSONEncode(MacroData)
		safeWriteFile(SAVE_FILE_NAME, json)
	end)
end

local function loadAllDataFromFile()
	pcall(function()
		local json = safeReadFile(SAVE_FILE_NAME)
		if json then
			local result = HttpService:JSONDecode(json)
			if result and result.Slots then
				MacroData = result
				if MacroData.AutoSpeedEnabled == nil then MacroData.AutoSpeedEnabled = true end
			end
		end
	end)
end

local function loadSlotToRuntime(slotNumber)
	recordedActions = {}
	pcall(function()
		local targetActions = MacroData.Slots[slotNumber] or {}
		for _, act in ipairs(targetActions) do
			local actCopy = {
				time = act.time,
				type = act.type,
				towerName = act.towerName
			}
			if act.pos then actCopy.pos = Vector3.new(act.pos.X, act.pos.Y, act.pos.Z) end
			if act.args then
				actCopy.args = {}
				for i, v in ipairs(act.args) do
					if typeof(v) == "table" and v.Type == "Vector3" then
						actCopy.args[i] = Vector3.new(v.X, v.Y, v.Z)
					else
						actCopy.args[i] = v
					end
				end
			end
			table.insert(serializableActions, actCopy)
		end
	end)
end

-- Safe UI Parent Detector
local function getUIContainer()
	local container = nil
	pcall(function()
		if gethui then
			container = gethui()
		elseif CoreGui then
			container = CoreGui
		end
	end)
	if not container then
		container = LocalPlayer:WaitForChild("PlayerGui")
	end
	return container
end

-- Hapus UI lama jika ada agar tidak bertumpuk
pcall(function()
	local targetParent = getUIContainer()
	if targetParent:FindFirstChild("MultiSlotMacroUI") then
		targetParent.MultiSlotMacroUI:Destroy()
	end
end)

