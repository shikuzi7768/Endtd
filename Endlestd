local function setSpeed(multiplier)
	if SpeedEvent then
		if SpeedEvent:IsA("RemoteFunction") then
			SpeedEvent:InvokeServer(multiplier)
		else
			SpeedEvent:FireServer(multiplier)
		end
	end
end

