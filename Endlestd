-- ==========================================
-- METAMETHOD HOOKING
-- ==========================================
local rawNamecall
rawNamecall = hookmetamethod(game, "__namecall", function(self, ...)
	local method = getnamecallmethod()
	local args = {...}

	if isRecording then
		task.spawn(function()
			-- Detect Place
			if PlaceEvent and (method == "FireServer" or method == "InvokeServer") and self == PlaceEvent then
				local towerId = args[1]
				local position = args[2]

				if position and typeof(position) == "Vector3" then
					local elapsedTime = (os.clock() - startTime) * getGameSpeed()
					local recordEntry = {
						Type = "Place",
						Time = elapsedTime,
						TowerId = towerId,
						Position = position,
						TurretIndex = #recordedTurretsOrder + 1
					}
					table.insert(recordedTurretsOrder, "Tower_" .. tostring(#recordedTurretsOrder + 1))
					table.insert(macroData, recordEntry)
					logConsole(string.format("Recorded Place #%d", recordEntry.TurretIndex))
				end
			end

			-- Detect Upgrade
			if ActionEvent and (method == "InvokeServer" or method == "FireServer") and self == ActionEvent then
				local actionType = args[1]
				local targetTurret = args[2]

				if actionType == "Upgrade" and targetTurret then
					local elapsedTime = (os.clock() - startTime) * getGameSpeed()
					local turretIndex = nil
					for idx, turretObj in ipairs(recordedTurretsOrder) do
						if turretObj == targetTurret then
							turretIndex = idx
							break
						end
					end

					if not turretIndex then
						table.insert(recordedTurretsOrder, targetTurret)
						turretIndex = #recordedTurretsOrder
					end

					local recordEntry = {
						Type = "Upgrade",
						Time = elapsedTime,
						TurretIndex = turretIndex,
						TurretName = typeof(targetTurret) == "Instance" and targetTurret.Name or "Unknown"
					}

					table.insert(macroData, recordEntry)
					logConsole(string.format("Recorded Upgrade Tower #%d", turretIndex))
				end
			end
		end)
	end

	return rawNamecall(self, ...)
end)

-- Listener folder tower
